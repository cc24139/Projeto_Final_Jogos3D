# Unity project path in this repository: /ProjetoFinal3D
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/ProjetoFinal3D/[Ll]ibrary/
/ProjetoFinal3D/[Tt]emp/
/ProjetoFinal3D/[Oo]bj/
/ProjetoFinal3D/[Bb]uild/
/ProjetoFinal3D/[Bb]uilds/
/ProjetoFinal3D/[Ll]ogs/
/ProjetoFinal3D/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/ProjetoFinal3D/[Mm]emoryCaptures/

# Recordings can get excessive in size
/ProjetoFinal3D/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /ProjetoFinal3D/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/ProjetoFinal3D/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/
.vscode/
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Operating system files
.DS_Store
Thumbs.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ProjetoFinal3D/ServerData/
/ProjetoFinal3D/[Aa]ssets/StreamingAssets/aa*
/ProjetoFinal3D/[Aa]ssets/AddressableAssetsData/link.xml*
/ProjetoFinal3D/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/ProjetoFinal3D/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/ProjetoFinal3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/ProjetoFinal3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/ProjetoFinal3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/ProjetoFinal3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/ProjetoFinal3D/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/ProjetoFinal3D/UIElementsSchema/

# Auto-generated cache in Assets folder
/ProjetoFinal3D/[Aa]ssets/[Ss]ceneDependencyCache*

AGENTS.md
docs/context/*
